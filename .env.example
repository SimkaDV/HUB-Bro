# Скопируйте в .env и заполните. Файл .env в git не попадает.

# mock — тестовые заказы; live — настоящий API Авито (нужна «Авито Доставка для бизнеса»)
AVITO_MODE=mock
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
SYNC_INTERVAL_SEC=300

# Владелец создаётся при первом запуске. Тестовые учётки для разработки:
#   admin@hubbro.local / admin, operator@hubbro.local / operator
# На сервере обязательно поменять.
ADMIN_EMAIL=admin@hubbro.local
ADMIN_PASSWORD=admin
SEED_DEMO=true

# По умолчанию SQLite в backend/hubbro.db. На сервере — Postgres:
# DATABASE_URL=postgresql+psycopg://hubbro:пароль@localhost/hubbro
